{
  "name": "linguapop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:auth": "sh -c 'eval \"$(supabase status -o env)\" && SUPABASE_TEST_URL=$API_URL SUPABASE_TEST_ANON_KEY=$ANON_KEY vitest run supabase-auth.integration'"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "10.13.0",
    "js-yaml": "5.5.0",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  }
}
