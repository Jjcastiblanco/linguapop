{
  "name": "linguapop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  }
}
