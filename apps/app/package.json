{
  "name": "@linguapop/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:native": "tsc -p tsconfig.json && vite build --mode native",
    "cap:sync": "pnpm run build:native && cap sync android",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capgo/capacitor-social-login": "8.7.5",
    "@capgo/capacitor-speech-recognition": "8.4.6",
    "@linguapop/content": "workspace:*",
    "@linguapop/domain": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
